# Untold Trails Environment Configuration
# Copy this file to .env and fill in optional API keys.
# NEVER commit .env to version control.

# Optional: Gemini API Key for the AI Trip Planner (if omitted, runs in smart local clustering mode)
GEMINI_API_KEY=

# Optional: OpenAI API Key (alternative LLM provider)
OPENAI_API_KEY=

# Optional: Server Port
PORT=8000

# Required for Email OTP Verification (e.g. Gmail App Password, Brevo, Resend SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false

# Optional: Google OAuth 2.0 Web Client ID for "Continue with Google"
GOOGLE_CLIENT_ID=
